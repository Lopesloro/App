# Copie para .env e ajuste. NUNCA commitar o .env (ver .gitignore).
# Apenas valores PUBLICOS aqui — segredo de verdade vive no backend ou em
# EAS Secrets / Actions secrets. Ver docs/06-seguranca.md.

# URL da API (variaveis EXPO_PUBLIC_* sao embutidas no bundle e ficam visiveis)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Ambiente: development | preview | production
APP_ENV=development
